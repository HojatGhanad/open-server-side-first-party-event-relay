# Copy to .env and fill in. Never commit .env.
# Generate random values with:  openssl rand -hex 24

# ── Images ───────────────────────────────────────────────────────────────────
# Defaults are fine for most setups. Pin a version tag in production.
# FP_RELAY_IMAGE=ghcr.io/hojatghanad/fp-relay:latest
# FP_SGTM_IMAGE=gcr.io/cloud-tagging-10302018/gtm-cloud-image:stable

# ── Server-side GTM ──────────────────────────────────────────────────────────
# Tag Manager > your SERVER container > Admin > Container Settings >
# "Manually provision tagging server" > copy the container config string.
CONTAINER_CONFIG=

# ── Deployment mode ──────────────────────────────────────────────────────────
# same_origin  the relay is reachable on a path of your site   (example.com/metrics)
# subdomain    the relay has its own hostname                  (metrics.example.com)
FP_DEPLOYMENT_MODE=same_origin

# Path prefix the relay strips before forwarding to sGTM. Must match the path your
# reverse proxy sends to the relay (see deploy/nginx/same-origin.conf).
FP_COLLECT_PREFIX=/metrics

# subdomain mode only: exact page origins, comma-separated. Wildcards are not allowed.
FP_SITE_ORIGINS=

# ── Debug endpoints ──────────────────────────────────────────────────────────
# Secret path segment for /_t/<token>/health.json, summary.json, recent.json.
FP_TRACE_TOKEN=

# Optional fixed IPs that always get full per-event traces. Usually left empty:
# visit /_t/<token>/trace-me from your browser to enrol your current IP instead.
FP_TRACE_CLIENT_IPS=
FP_TRACE_ENROLL_HOURS=8

# Paste the X-Gtm-Server-Preview value from GTM Preview to route ALL traffic to the
# preview container. Leave empty in normal operation.
FP_PREVIEW_TOKEN=

# ── Protected transport (optional) ───────────────────────────────────────────
# Single-site setup without tenants.yml. For multiple sites, set these per tenant
# in tenants.yml instead. Use different values for every site.
#   segment: 10 random alphanumerics, key: 32 random alphanumerics
FP_PROTECTED_SEGMENT=
FP_PROTECTED_KEY=
# Tag serving path of the Web Container client in your server container, e.g. /AbC123xyZ
FP_LOADER_PATH=

# ── Admin API (used by the panel) ────────────────────────────────────────────
# Bearer token for /_admin/*. Empty disables those endpoints.
FP_ADMIN_TOKEN=

# ── Panel (optional, docker compose --profile panel up -d) ───────────────────
PANEL_DB_PASSWORD=
PANEL_ADMIN_USER=admin
# BCrypt hash of the panel password, never the password itself:
#   docker run --rm httpd:2.4-alpine htpasswd -bnBC 12 "" 'your-password' | tr -d ':\n'
PANEL_ADMIN_PASSWORD_HASH=
